<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Target.Views.Quiz"
             Title="חידון צה״ל"
             FlowDirection="RightToLeft">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

            <Label Text="{Binding Question}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <Button Text="{Binding Answers[0]}" 
                    Command="{Binding AnswerCommand}" 
                    IsEnabled="{Binding IsNotBusy}"
                    FontSize="18">
                <Button.CommandParameter>
                    <x:Int32>0</x:Int32>
                </Button.CommandParameter>
            </Button>

            <Button Text="{Binding Answers[1]}" 
                    Command="{Binding AnswerCommand}" 
                    IsEnabled="{Binding IsNotBusy}"
                    FontSize="18">
                <Button.CommandParameter>
                    <x:Int32>1</x:Int32>
                </Button.CommandParameter>
            </Button>

            <Button Text="{Binding Answers[2]}" 
                    Command="{Binding AnswerCommand}" 
                    IsEnabled="{Binding IsNotBusy}"
                    FontSize="18">
                <Button.CommandParameter>
                    <x:Int32>2</x:Int32>
                </Button.CommandParameter>
            </Button>

            <Button Text="{Binding Answers[3]}" 
                    Command="{Binding AnswerCommand}" 
                    IsEnabled="{Binding IsNotBusy}"
                    FontSize="18">
                <Button.CommandParameter>
                    <x:Int32>3</x:Int32>
                </Button.CommandParameter>
            </Button>

            <Label Text="{Binding Result}"
                   FontSize="22"
                   TextColor="{StaticResource Primary}"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,0"/>

            <Button Text="שאלה הבאה"
                    Command="{Binding NextQuestionCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="Gray"
                    TextColor="White"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>