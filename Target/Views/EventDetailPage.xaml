<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Target.ViewModels"
             x:Class="Target.Views.EventDetailPage"
             Title="פרטי פעילות">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label Text="שם האירוע" FontSize="18" TextColor="{StaticResource Gray200}"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <Entry Text="{Binding Title}" HorizontalOptions="FillAndExpand"/>
            </Border>

            <Label Text="תיאור" FontSize="18" TextColor="{StaticResource Gray200}"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <Editor Text="{Binding Description}" FontSize="20"
                AutoSize="TextChanges" HeightRequest="100"/>
            </Border>

            <Label Text="סוג פעילות" FontSize="18" TextColor="{StaticResource Gray200}"/>
            <Border Stroke="Gray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    HorizontalOptions="Fill"
                    Padding="4">
                <Picker Title="בחר סוג פעילות"
                        TextColor="White"
                        SelectedItem="{Binding Type}"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Start" 
                        FontSize="15">
                    <Picker.Items>
                        <x:String>אימון</x:String>
                        <x:String>יום מיון</x:String>
                        <x:String>אחר</x:String>
                    </Picker.Items>
                </Picker>
            </Border>
            
            <Label Text="תאריך" FontSize="18" TextColor="{StaticResource Gray200}"/>
            <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <DatePicker TextColor="White" FontSize="30" HorizontalOptions="Center"
                    Date="{Binding Date}" Format="dd/MM/yyyy"/>
            </Border>

            <Border Stroke="Gray"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 8"
        Padding="10">

                <Grid ColumnDefinitions="*,*"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="15"
          RowSpacing="5">

                    <!-- כותרות -->
                    <Label Text="שעת התחלה"
               Grid.Row="0"
               Grid.Column="0"
               FontSize="16"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource Gray200}" />

                    <Label Text="שעת סיום"
               Grid.Row="0"
               Grid.Column="1"
               FontSize="16"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource Gray200}" />

                    <!-- TimePickers -->
                    <TimePicker Grid.Row="1"
                    Grid.Column="0"
                    Time="{Binding StartTime}"
                    Format="HH:mm"
                    HorizontalOptions="Center" />

                    <TimePicker Grid.Row="1"
                    Grid.Column="1"
                    Time="{Binding EndTime}"
                    Format="HH:mm"
                    HorizontalOptions="Center" />

                </Grid>
            </Border>


            <Button Text="שמור שינויים" FontSize="20"
            Command="{Binding SaveEventCommand}" />

            <Button Text="מחק אירוע" FontSize="20"
            Command="{Binding DeleteEventCommand}"
            BackgroundColor="Red"
            TextColor="White" />

        </StackLayout>
    </ScrollView>
</ContentPage>
