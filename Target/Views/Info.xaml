<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Target.Views.Info"
             x:Name="PageRoot"
             Title="Info">
    
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*" Padding="20">

            <!-- Title -->
            <StackLayout Grid.Row="0" Spacing="5" HorizontalOptions="Center">
                <Label Text="מידע על יחידות"
                   FontSize="40"
                   FontFamily="NarkisBold"
                   HorizontalOptions="Center"/>
            </StackLayout>

            <!-- UnitsBox -->
            <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Units}"
                        ItemsLayout="VerticalGrid, 2"
                        SelectionMode="None"
                        VerticalOptions="Fill"
                        Margin="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#ffffff"
                            StrokeThickness="3"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#0e0000"
                            HeightRequest="130"
                            Margin="5">

                            <!-- Recognizer -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                Command="{Binding BindingContext.UnitTappedCommand, Source={x:Reference PageRoot}}"
                                CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Padding="15"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                                <Image HeightRequest="70"
                                   Source="{Binding Logo}"
                                   HorizontalOptions="Center"/>
                                <Label Text="{Binding Title}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </ContentPage.Content>
</ContentPage>